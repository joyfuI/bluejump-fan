{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/cafe-articles",
      "has": [
        { "type": "query", "key": "cafeId", "value": "(?<cafeId>\\d{7,9})" },
        { "type": "query", "key": "menuId", "value": "(?<menuId>\\d{1,4})" },
        { "type": "query", "key": "page", "value": "(?<page>[1-9]\\d{0,2})" },
        {
          "type": "query",
          "key": "pageSize",
          "value": "(?<pageSize>[1-9]|[1-9]\\d|100)"
        }
      ],
      "destination": "https://apis.naver.com/cafe-web/cafe-boardlist-api/v1/cafes/:cafeId/menus/:menuId/articles?page=:page&pageSize=:pageSize&sortBy=TIME&viewType=C"
    },
    {
      "source": "/api/vod-search",
      "has": [
        { "type": "query", "key": "keyword", "value": "(?<keyword>.{1,20})" },
        { "type": "query", "key": "page", "value": "(?<page>[1-9]\\d{0,2})" },
        {
          "type": "query",
          "key": "limit",
          "value": "(?<limit>[1-9]|[1-9]\\d|100)"
        },
        {
          "type": "query",
          "key": "term",
          "value": "(?<term>all|1day|1week|1month|1year)"
        }
      ],
      "destination": "https://sch.sooplive.com/api.php?l=DF&m=vodSearch&w=webk&isMobile=0&szType=json&c=UTF-8&v=5.0&szKeyword=:keyword&nPageNo=:page&nListCnt=:limit&szOrder=reg_date&nIncludeTranslationMatch=0&szFileType=ALL&szTerm=:term&tab=vod&location=total_search&isHashSearch=0"
    }
  ],
  "headers": [
    {
      "source": "/api/cafe-articles",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "Cache-Control", "value": "public, max-age=120" },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=36000"
        }
      ]
    },
    {
      "source": "/api/vod-search",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "Cache-Control", "value": "public, max-age=60" },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
